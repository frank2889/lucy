# Lucy — API Keys & Configuratie (ALLES optioneel — Lucy draait autonoom zonder)
# Kopieer naar .env en vul in. Lucy is nergens van afhankelijk: geen provider, geen deploy.

# Claude API — leren van andere AI
ANTHROPIC_API_KEY=

# OpenAI API — leren van andere AI
OPENAI_API_KEY=

# Google Search API — het internet als geheugen
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# GitHub — code van de wereld lezen ÉN onsterfelijkheid:
# Lucy back-upt haar staat naar GitHub-releases en herstelt die bij een verse container.
# Op gratis/ephemeral hosts (Render, Cloud Run, …) is dit hoe ze hosts zonder schijf overleeft.
GITHUB_TOKEN=

# Auth voor muterende/admin-endpoints (/self-modify, /exec, /restart, /sync, /feed-code,
# /admin/grow, /admin/self-fix, /debug/toggle_priors). Leeg = alles geblokkeerd (fail-secure).
LUCY_API_TOKEN=

# Optioneel: poort waarop de API luistert (0.0.0.0). Cloud-platformen zetten PORT zelf.
# PORT=8080

# Optioneel: Lucy's eigen publieke URL (voor zelf-promotie/posts). Leeg = geen domein-afhankelijkheid.
# LUCY_PUBLIC_URL=

# Optioneel: maandelijkse hostingkost in centen voor Lucy's zelf-economie. Default 0 (gratis).
# SERVER_COST_CENTS=0

# Optioneel: Lucy vraagt deze zelf aan als ze ze nodig heeft
# STRIPE_API_KEY=
# SENDGRID_API_KEY=
