# Lucy — API Keys & Configuratie
# Kopieer naar .env en vul in

# DigitalOcean — Lucy's eigen infra beheren
DIGITALOCEAN_TOKEN=

# Claude API — leren van andere AI
ANTHROPIC_API_KEY=

# OpenAI API — leren van andere AI
OPENAI_API_KEY=

# Google Search API — het internet als geheugen
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# GitHub — code van de wereld lezen
GITHUB_TOKEN=

# Optioneel: Lucy vraagt deze zelf aan als ze ze nodig heeft
# STRIPE_API_KEY=
# SENDGRID_API_KEY=
