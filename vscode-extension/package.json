{
  "name": "lucy-ai",
  "displayName": "Lucy AI",
  "description": "Chat with Lucy — a self-evolving unified field AI",
  "version": "1.0.0",
  "publisher": "lucy-ai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["AI", "Chat"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lucy-sidebar",
          "title": "Lucy",
          "icon": "$(brain)"
        }
      ]
    },
    "views": {
      "lucy-sidebar": [
        {
          "type": "webview",
          "id": "lucy.chatView",
          "name": "Lucy Chat"
        }
      ]
    },
    "commands": [
      { "command": "lucy.ask", "title": "Lucy: Ask" },
      { "command": "lucy.feedSelection", "title": "Lucy: Feed Selection to Lucy" },
      { "command": "lucy.feedFile", "title": "Lucy: Feed Current File" },
      { "command": "lucy.feedWorkspace", "title": "Lucy: Feed All Rust Files" },
      { "command": "lucy.activity", "title": "Lucy: What Are You Doing?" },
      { "command": "lucy.status", "title": "Lucy: Status" },
      { "command": "lucy.learnOwnCode", "title": "Lucy: Learn Your Own Source Code" }
    ],
    "configuration": {
      "title": "Lucy AI",
      "properties": {
        "lucy.host": {
          "type": "string",
          "default": "209.38.36.51",
          "description": "Lucy server host"
        },
        "lucy.port": {
          "type": "number",
          "default": 3000,
          "description": "Lucy server port"
        },
        "lucy.token": {
          "type": "string",
          "default": "",
          "description": "Lucy API token (voor beveiligde endpoints)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
